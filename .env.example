APP_NAME="University Marketplace"
DEBUG=True
SECRET_KEY=change-this-to-a-long-random-string-in-production
DATABASE_URL=sqlite:///./university_marketplace.db
ALLOWED_HOSTS=*
SESSION_MAX_AGE=604800
DELIVERY_FEE_ESTIMATE=300.0

# --- Payments ---------------------------------------------------------------
# "mock" needs no keys and simulates a full pay flow locally (a fake
# checkout page you click through) -- keep this until you're ready to test
# against a real sandbox account. If you switch to a real gateway below but
# leave its keys blank, the app quietly falls back to mock instead of
# crashing, so it's always safe to leave these as placeholders.
PAYMENT_GATEWAY=mock
PAYMENT_CURRENCY=NGN
APP_BASE_URL=http://localhost:8000

# Fill in only the block for whichever gateway you set PAYMENT_GATEWAY to.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
